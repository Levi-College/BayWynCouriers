<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:BayWyn_Couriers.ViewModels"
                    xmlns:view="clr-namespace:BayWyn_Couriers.Views">

    <!--This ensure that when LoginWindowVM is used, the view associated with it is Login view (used for the design)-->
    <DataTemplate DataType="{x:Type vm:LoginVM}">
        <view:Login />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:AdminVM}">
        <view:Admin />
    </DataTemplate>

</ResourceDictionary>