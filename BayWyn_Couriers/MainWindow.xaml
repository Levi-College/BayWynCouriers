<Window x:Class="BayWyn_Couriers.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BayWyn_Couriers"
        xmlns:vm="clr-namespace:BayWyn_Couriers.ViewModels"
        xmlns:view="clr-namespace:BayWyn_Couriers.Views"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d"
        Title="BayWyn Couriers" Height="800" Width="1000">

    <Window.DataContext>
        <vm:NavigationVM />
    </Window.DataContext>

    <!--This grid will hold the content control to switch between the user controls (login and user window-->
    <Grid>
        <ContentControl x:Name="UserWindow" 
                        Content="{Binding CurrentView}" />
    </Grid>
</Window>
