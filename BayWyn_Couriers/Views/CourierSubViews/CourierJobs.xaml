<UserControl x:Class="BayWyn_Couriers.Views.CourierSubViews.CourierJobs"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BayWyn_Couriers.Views.CourierSubViews"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">

    <Grid Background="AntiqueWhite" Margin="5">

        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Structure to hold the edit window and the buttons-->

        <!--Filter and date picker-->
        <ComboBox Grid.Column="0" 
              ItemsSource="{Binding LCJobsFilterList}"
              SelectedItem="{Binding SelectedJobStatus, UpdateSourceTrigger=PropertyChanged}"
              Margin="648,0,0,0" Width="120" HorizontalAlignment="Left" VerticalAlignment="Center"/>

        <!--Header for the edit column-->
        <TextBlock Grid.Row="0" Grid.Column="1" Text="Pending Acceptance" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10"/>

        <ItemsControl Grid.Row="1" ItemsSource="{Binding PendingJobs}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="8" Margin="10" Padding="15" Background="White">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="{Binding ClientName}" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="{Binding DeliveryAddress}" TextWrapping="Wrap" Margin="0,5"/>
                                <TextBlock Text="{Binding DeliverySlot}" Foreground="DarkBlue" FontWeight="SemiBold"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Accept" Command="{Binding DataContext.AcceptCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                                CommandParameter="{Binding}" Background="Green" Foreground="White" Width="80" Margin="5"/>
                                <Button Content="Reject" Command="{Binding DataContext.RejectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                                CommandParameter="{Binding}" Background="Red" Foreground="White" Width="80" Margin="5"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!--Data grid for the jobs to be displayed
        <DataGrid AutoGenerateColumns="False"
              ItemsSource="{Binding AllJobs}" 
              SelectedItem="{Binding Path=SelectedJob, Mode=TwoWay}"
              IsReadOnly="True"
              Grid.Row="1" Grid.Column="0">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Job ID" Binding="{Binding JobId}" Width="Auto"/>
                <DataGridTextColumn Header="Address" Binding="{Binding DeliveryAddress}" Width="*"/>
                <DataGridTextColumn Header="Delivery Date" Binding="{Binding StartDate, StringFormat=d}" Width="*"/>
                <DataGridTemplateColumn Header="Action" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
