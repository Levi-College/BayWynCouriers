<UserControl x:Class="BayWyn_Couriers.Views.CourierSubViews.CourierAcceptedJobs"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BayWyn_Couriers.Views.CourierSubViews" 
             xmlns:viewmodels="clr-namespace:BayWyn_Couriers.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:CourierVM}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="AntiqueWhite" Margin="5">

        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Structure to hold the edit window and the buttons-->

        <!--Header for the edit column-->
        <TextBlock Grid.Row="0" Grid.Column="1" Text="Accepted Jobs" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10"/>

        <ItemsControl Grid.Row="1" ItemsSource="{Binding AcceptedJobs}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="8" Margin="10" Padding="15" Background="White">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="{Binding ClientName}" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="{Binding DeliveryAddress}" TextWrapping="Wrap" Margin="0,5"/>
                                <TextBlock Text="{Binding DeliveryDate, StringFormat=d}"/>
                                <TextBlock Text="{Binding DeliverySlot}" Foreground="DarkBlue" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
