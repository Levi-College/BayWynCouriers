<UserControl x:Class="BayWyn_Couriers.Views.CourierSubViews.CourierAcceptedJobs"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BayWyn_Couriers.Views.CourierSubViews" 
             xmlns:viewmodels="clr-namespace:BayWyn_Couriers.ViewModels" 
             d:DataContext="{d:DesignInstance Type=viewmodels:CourierVM}"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="My Accepted Schedule" FontSize="24" FontWeight="Bold" Foreground="#1A1F26"/>
            <TextBlock Text="These are your confirmed deliveries. Switch to the Shift tab to begin work." Foreground="#64748B" FontSize="14"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding AcceptedJobs}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" CornerRadius="12" Margin="0,0,10,15" Padding="20">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" Direction="270" ShadowDepth="2" Opacity="0.07"/>
                            </Border.Effect>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <TextBlock Text="{Binding ClientName}" FontSize="20" FontWeight="Bold" Foreground="#1E293B"/>
                                        <Border Background="#D1FAE5" CornerRadius="12" Padding="10,2" Margin="15,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Confirmed" Foreground="#065F46" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="Delivery Location:" FontSize="11" Foreground="#94A3B8" FontWeight="Bold" Margin="0,5,0,2"/>
                                    <TextBlock Text="{Binding DeliveryAddress}" Foreground="#334155" FontSize="14" TextWrapping="Wrap" MaxWidth="500" HorizontalAlignment="Left"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Border Background="#F1F5F9" CornerRadius="8" Padding="15,10">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding DeliveryDate, StringFormat=MMM dd}" FontSize="16" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding DeliverySlot}" FontSize="14" Foreground="#0369A1" FontWeight="ExtraBold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="SCHEDULED" FontSize="9" Foreground="#94A3B8" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>