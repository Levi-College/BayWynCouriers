<UserControl x:Class="BayWyn_Couriers.Views.CourierSubViews.CourierShift"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BayWyn_Couriers.Views.CourierSubViews" 
             xmlns:viewmodels="clr-namespace:BayWyn_Couriers.ViewModels" 
             d:DataContext="{d:DesignInstance Type=viewmodels:CourierVM}"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Daily Shift Schedule" FontSize="24" FontWeight="Bold" Foreground="#1A1F26"/>
                <TextBlock Text="{Binding CurrentTimeDisplay, StringFormat='Today: {0}'}" Foreground="#64748B" FontSize="14"/>
            </StackPanel>
            <Border HorizontalAlignment="Right" Background="#1A1F26" CornerRadius="8" Padding="15,5">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⏱️" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding ShiftTimerDisplay}" FontSize="28" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Direction="270" ShadowDepth="2" Opacity="0.1"/>
            </Border.Effect>
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Command="{Binding StartShiftCommand}" 
                            IsEnabled="{Binding StartShiftEnabler}"
                            Width="180" Height="50" Margin="10,0"
                            Background="#10B981" Foreground="White" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="▶  " VerticalAlignment="Center" FontWeight="Bold"/>
                                        <TextBlock Text="START SHIFT" VerticalAlignment="Center" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Command="{Binding EndShiftCommand}" 
                            IsEnabled="{Binding EndShiftEnabler}"
                            Width="180" Height="50" Margin="10,0"
                            Background="#EF4444" Foreground="White" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="■  " VerticalAlignment="Center" FontWeight="Bold"/>
                                        <TextBlock Text="END SHIFT" VerticalAlignment="Center" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Remaining Deliveries" FontSize="16" FontWeight="SemiBold" Foreground="#475569" Margin="5,0,0,10"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding DailyJobs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="10" Margin="0,0,10,12" Padding="15" BorderBrush="#F1F5F9" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.05"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DeliverySlot}" FontSize="18" FontWeight="ExtraBold" Foreground="#0369A1" HorizontalAlignment="Center"/>
                                        <TextBlock Text="TIME SLOT" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="20,0">
                                        <TextBlock Text="{Binding ClientName}" FontSize="16" FontWeight="Bold" Foreground="#1E293B"/>
                                        <TextBlock Text="{Binding DeliveryAddress}" Foreground="#475569" TextWrapping="Wrap" Margin="0,2,0,5"/>
                                        <Border Background="#F8FAFC" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#64748B" FontStyle="Italic"/>
                                        </Border>
                                    </StackPanel>

                                    <Button Grid.Column="2" 
                                            Content="COMPLETE" 
                                            Command="{Binding DataContext.CompleteDeliveryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding DataContext.EnableCompleteJobButton, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            Width="110" Height="40" VerticalAlignment="Center"
                                            Background="#0369A1" Foreground="White" BorderThickness="0" FontWeight="Bold">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="20">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Style.Triggers>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Opacity" Value="0.4"/>
                                                        <Setter Property="Background" Value="#94A3B8"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>