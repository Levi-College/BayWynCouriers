<UserControl x:Class="BayWyn_Couriers.Views.CourierSubViews.CourierPendingJobs"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BayWyn_Couriers.Views.CourierSubViews" 
             xmlns:viewmodels="clr-namespace:BayWyn_Couriers.ViewModels" 
             d:DataContext="{d:DesignInstance Type=viewmodels:CourierVM}"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="New Job Invitations" FontSize="24" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="Review and accept your assigned delivery slots below." Foreground="#64748B" FontSize="14"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding PendingJobs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource JobCardBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ClientName}" FontSize="20" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,5"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Border Background="#F1F5F9" CornerRadius="4" Padding="8,4" Margin="0,0,10,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="📅 " VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding DeliveryDate, StringFormat=d}" Foreground="#475569" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#E0F2FE" CornerRadius="4" Padding="8,4">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🕒 " VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding DeliverySlot}" Foreground="#0369A1" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="Delivery Location:" FontSize="11" Foreground="#94A3B8" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding DeliveryAddress}" Foreground="#334155" FontSize="14" TextWrapping="Wrap" MaxWidth="400" HorizontalAlignment="Left"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Accept" 
                                    Background="#10B981"
                                    Style="{StaticResource JobActionButtonStyle}"
                                    Command="{Binding DataContext.AcceptJobCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                                    CommandParameter="{Binding}"/>

                                        <Button Content="Reject" 
                                    Background="#EF4444"
                                    Style="{StaticResource JobActionButtonStyle}"
                                    Command="{Binding DataContext.RejectJobCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                                    CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
         
        </ScrollViewer>
    </Grid>
</UserControl>