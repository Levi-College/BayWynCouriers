<UserControl x:Class="BayWyn_Couriers.Views.LC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BayWyn_Couriers.Views"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="800"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Background="DarkBlue">
            <Button Content="Manage Contracts" Command="{Binding ShowContractsCommand}" />
            <Button Content="View Reports" Command="{Binding ShowReportsCommand}" />
        </StackPanel>


        <!-- Side Menu -->
        <Grid Grid.Column="0" Background="Aqua">

            <Grid.RowDefinitions>
                <RowDefinition Height="100"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Beige">
                <Label Content="BayWyn Couriers" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Arial Black" FontSize="20"/>
            </Grid>

            <!--Side menu buttons-->
            <Grid Grid.Row="1">
                <StackPanel Orientation="Vertical">
                    <Button Content="Manage Jobs" Command="{Binding JobsCommand }" Height="40" Margin="0,5,5,5"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Main Content Area -->
        <Grid Grid.Column="1" Background="Azure">
            <Grid.RowDefinitions>
                <RowDefinition Height="100"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#2C3E50">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="600" />
                    <ColumnDefinition Width="200" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Label Content="Welcome LC" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="AntiqueWhite" FontFamily="Arial Black" FontSize="20"/>
                </Grid>

                <Grid Grid.Column="1">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" >
                        <Label Content="LC" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="AntiqueWhite" FontFamily="Arial Black" FontSize="20"/>
                        <Button Content="Logout" Command="{Binding LogoutCommand}" Width="80" Height="30"/>
                    </StackPanel>
                </Grid>


            </Grid>

            <Grid Grid.Row="1" Background="White">
                <ContentControl Content="{Binding CurrentSubView}" />
            </Grid>

        </Grid>
    </Grid>
</UserControl>
