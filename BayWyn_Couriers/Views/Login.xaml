<UserControl x:Class="BayWyn_Couriers.Views.Login"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BayWyn_Couriers.Views"
             xmlns:vm="clr-namespace:BayWyn_Couriers.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=vm:LoginVM, IsDesignTimeCreatable=False}">

    <Grid Background="AntiqueWhite">
        <TextBox x:Name="txtPassword" 
            Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
            HorizontalAlignment="Left" Margin="359,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center" Width="120"/>

        <TextBox x:Name="txtUsername"
            Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
            HorizontalAlignment="Left" Margin="358,161,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>

        <Button x:Name="btnLogin" Content="Login" 
                Command="{Binding LoginCommand}"
                HorizontalAlignment="Left" Margin="374,273,0,0" VerticalAlignment="Top" Height="47" Width="101"/>
    </Grid>


</UserControl>
