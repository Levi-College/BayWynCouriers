<UserControl x:Class="BayWyn_Couriers.Views.Login"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BayWyn_Couriers.Views"
             xmlns:vm="clr-namespace:BayWyn_Couriers.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="400"
             d:DataContext="{d:DesignInstance Type=vm:LoginVM, IsDesignTimeCreatable=False}">

    <Grid>
        <Border Style="{StaticResource LoginWindowBorder}">
            <StackPanel Style="{StaticResource CenterStackPanel}">
                <TextBlock Text="BAYWYN COURIERS" Style="{StaticResource BrandLogo1}"/>
                <Grid Margin="0,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PlaceholderText}" Text="Username"/>
                        <TextBox Style="{StaticResource InputBox}" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PlaceholderText}" Text="Password"/>
                        <PasswordBox x:Name="UserPasswordBox" Style="{StaticResource PasswordBox}"/>
                    </StackPanel>
                </Grid>

                <Button Content="Log in" Command="{Binding LoginCommand}" CommandParameter="{Binding ElementName=UserPasswordBox}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
