<UserControl x:Class="BayWyn_Couriers.Views.Login"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BayWyn_Couriers.Views"
             xmlns:vm="clr-namespace:BayWyn_Couriers.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="400"
             d:DataContext="{d:DesignInstance Type=vm:LoginVM, IsDesignTimeCreatable=False}">
    
    <Grid>
        <Border Style="{StaticResource LoginWindowBorder}" Background="White">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Direction="270" Opacity="0.2" ShadowDepth="2"/>
            </Border.Effect>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="BAYWYN COURIERS" 
                           FontSize="28" 
                           FontWeight="Bold" 
                           Margin="0,0,0,20" 
                           Foreground="#222"
                           HorizontalAlignment="Center"/>
               
                <Grid Margin="0,10">
                    <StackPanel>
                        <TextBlock 
                           Text="Username" 
                           VerticalAlignment="Center" 
                           Foreground="Gray">
                        </TextBlock>
                        <TextBox x:Name="txtUsername"
                                 Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                                 Height="40" 
                                 Padding="10,0" 
                                 VerticalContentAlignment="Center"
                                 BorderBrush="#CCC"
                                 BorderThickness="1"/>
                    </StackPanel>
                    
                </Grid>

                <Grid Margin="0,10">
                    <StackPanel>
                        <TextBlock 
    Text="Password" 
    VerticalAlignment="Center" 
    Foreground="Gray">
                        </TextBlock>
                        <PasswordBox x:Name="UserPasswordBox" 
                             Height="45" 
                             Padding="10,0" 
                             VerticalContentAlignment="Center"
                             BorderBrush="#CCC"
                             BorderThickness="1"/>
                    </StackPanel>
                    
                </Grid>

                <Button Content="Log in" 
                    Command="{Binding LoginCommand}"
                    CommandParameter="{Binding ElementName=UserPasswordBox}"
                    Height="50" 
                    Margin="0,20,0,10"
                    Foreground="White" 
                    FontWeight="Bold"
                    BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>
    </Grid>


</UserControl>
