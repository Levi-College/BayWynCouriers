<UserControl x:Class="BayWyn_Couriers.Views.Admin"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BayWyn_Couriers.Views"
             xmlns:vm="clr-namespace:BayWyn_Couriers.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1000">

    

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="800"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Background="DarkBlue">
            <Button Content="Manage Contracts" Command="{Binding ShowContractsCommand}" />
            <Button Content="View Reports" Command="{Binding ShowReportsCommand}" />
        </StackPanel>


        <!-- Side Menu -->
        <Grid Grid.Column="0" Background="Aqua">

            <Grid.RowDefinitions>
                <RowDefinition Height="100"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Beige">
                <Label Content="BayWyn Couriers" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Arial Black" FontSize="20"/>
            </Grid>

            <!--Side menu buttons
            <Grid Grid.Row="1">
                <StackPanel Orientation="Vertical">
                    <Button Content="Manage Jobs" Command="{Binding JobsCommand }" IsDefault="True" Height="40" Margin="0,5,5,5"/>
                    <Button Content="Reports" Command="{Binding ReportsCommand}" Height="40" Margin="0,5,5,5"/>
                    <Button Content="Contracts" Command="{Binding ContractsCommand}" Height="40" Margin="0,5,5,5"/>
                    <Button Content="Clients" Command="{Binding ClientsCommand}" Height="40" Margin="0,5,5,5"/>
                    <Button Content="Couriers" Command="{Binding CouriersCommand}" Height="40" Margin="0,5,5,5"/>
                </StackPanel>
            </Grid>
            -->

            <Grid Grid.Row="1">
                <StackPanel Orientation="Vertical">
                    <StackPanel.Resources>
                        <!-- A style that makes RadioButtons look like Menu Buttons -->
                        <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                            <Setter Property="Height" Value="40"/>
                            <Setter Property="Margin" Value="0,5,5,5"/>
                            <Setter Property="Background" Value="#F0F0F0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <!-- Highlighting the selected menu item -->
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter Property="Background" Value="#007BFF"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </StackPanel.Resources>

                    <!-- Use IsChecked="True" on the first one to select it by default -->
                    <RadioButton Content="Manage Jobs" Command="{Binding JobsCommand}" IsChecked="True"/>
                    <RadioButton Content="Reports" Command="{Binding ReportsCommand}"/>
                    <RadioButton Content="Contracts" Command="{Binding ContractsCommand}"/>
                    <RadioButton Content="Clients" Command="{Binding ClientsCommand}"/>
                    <RadioButton Content="Couriers" Command="{Binding CouriersCommand}"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Main Content Area -->
        <Grid Grid.Column="1" Background="Azure">
            <Grid.RowDefinitions>
                <RowDefinition Height="100"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#2C3E50">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="600" />
                    <ColumnDefinition Width="200" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Label Content="Welcome Admin" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="AntiqueWhite" FontFamily="Arial Black" FontSize="20"/>
                </Grid>

                <Grid Grid.Column="1">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" >
                        <Label Content="Admin Name" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="AntiqueWhite" FontFamily="Arial Black" FontSize="20"/>
                        <Button Content="Logout" Command="{Binding LogoutCommand}" Width="80" Height="30"/>
                    </StackPanel>
                </Grid>


            </Grid>

            <Grid Grid.Row="1" Background="White">
                <ContentControl Content="{Binding CurrentSubView}" />
            </Grid>
          
        </Grid>
    </Grid>

    
</UserControl>
