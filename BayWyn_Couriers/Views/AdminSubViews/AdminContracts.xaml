<UserControl x:Class="BayWyn_Couriers.Views.AdminSubViews.AdminContracts"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BayWyn_Couriers.Views.AdminSubViews" 
             xmlns:viewmodels="clr-namespace:BayWyn_Couriers.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:AdminVM}"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid Margin="5">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- Structure to hold the edit window and the buttons-->

        <!--Filter and date picker-->
        <ComboBox Grid.Row="0" Grid.Column="0" 
              ItemsSource="{Binding ContractsFilterList}" Style="{StaticResource ModernComboBoxStyle}"
              SelectedItem="{Binding SelectedContractStatus, UpdateSourceTrigger=PropertyChanged}"
              Margin="10" Width="120" HorizontalAlignment="Left" VerticalAlignment="Center">
        </ComboBox>


        <Button Content="New Contract" Command="{Binding NewContractCommand}" Style="{StaticResource PageButton}"
            Grid.Row="0" Grid.Column="0" HorizontalAlignment="Right" Margin="0,0,20,0"
            />
        <!--Header for the edit column-->
        <TextBlock Grid.Row="0" Grid.Column="1" Text="Edit/New" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10" Foreground="White"/>

        <!--Data grid for the Contracts to be displayed-->
        <Border Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Direction="270" ShadowDepth="2" Opacity="0.05"/>
            </Border.Effect>

            <DataGrid AutoGenerateColumns="False" Style="{StaticResource MainDataGridStyle}"
              ItemsSource="{Binding AllContracts}" 
              SelectedItem="{Binding Path=SelectedContract, Mode=TwoWay}"
              IsReadOnly="True"
              x:Name="ContractsList">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Contract ID" Binding="{Binding ContractId}" Width="Auto"/>
                    <DataGridTemplateColumn Header="Company" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding CompanyName}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="5,0" TextWrapping="Wrap" Background="Transparent"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    
                    <DataGridTextColumn Header="Status" Binding="{Binding ContractStatus}" Width="*"/>
                </DataGrid.Columns>

            </DataGrid>
        </Border>


      
        <Border Grid.Row="1" Grid.Column="1" Background="#1A1F26" CornerRadius="10" Padding="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Direction="270" ShadowDepth="2" Opacity="0.05"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Label Grid.Row="1" Grid.Column="0" Content="Company/Client:" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="comboBoxClients" Margin="0,5"  Style="{StaticResource ModernComboBoxStyle2}"
                          ItemsSource="{Binding ClientList}" SelectedItem="{Binding SelectedClient}"
                          DisplayMemberPath="Name" SelectedValuePath="ClientId" 
                          IsEnabled="{Binding EnableItemsForNewContract}" Height="30"/>

                        <Label Grid.Row="2" Grid.Column="0" Content="Started Date:" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,5" Height="30" Width="150" HorizontalAlignment="Left" Style="{StaticResource InputTextBox}"
                         IsEnabled="{Binding EnableItemsForNewContract}" Text="{Binding SelectedContract.StartDate, StringFormat=d, Mode=TwoWay}" />

                        <Label Grid.Row="3" Grid.Column="0" Content="End Date:" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,5" Height="30" Width="150" Style="{StaticResource InputTextBox}" HorizontalAlignment="Left"
                         IsEnabled="{Binding EnableItemsForNewContract}" Text="{Binding SelectedContract.EndDate, StringFormat=d, Mode=TwoWay}" />

                        <Label Grid.Row="4" Grid.Column="0" Content="Phone:" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Margin="0,5" Height="30" Style="{StaticResource InputTextBox}"
                         Text="{Binding SelectedContract.PhoneNumber, Mode=TwoWay}"/>

                        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Margin="0,5">
                            <Label Content="Email:" Foreground="#94A3B8"/>
                            <TextBox Text="{Binding SelectedContract.Email, Mode=TwoWay}" Style="{StaticResource InputTextBox}" Height="30"/>
                        </StackPanel>

                        <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Margin="0,5">
                            <Label Content="Address:" Foreground="#94A3B8"/>
                            <TextBox Text="{Binding SelectedContract.Address, Mode=TwoWay}" Style="{StaticResource InputTextBox}" Height="30"/>
                        </StackPanel>

                        <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Margin="0,5">
                            <Label Content="Notes:" Foreground="#94A3B8"/>
                            <TextBox TextWrapping="Wrap" Text="{Binding SelectedContract.Notes, Mode=TwoWay}" Style="{StaticResource InputTextBox}" Height="60"/>
                        </StackPanel>

                        <Label Grid.Row="8" Grid.Column="0" Content="Contract Status:" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="8" Grid.Column="1" TextWrapping="Wrap" Text="{Binding SelectedContract.ContractStatus, Mode=TwoWay}" Style="{StaticResource InputTextBox}" IsReadOnly="True" />


                        <StackPanel Grid.Row="9" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10">
                            <Label Content="Monthly Cost:" Foreground="#94A3B8"/>
                            <Label Content="{Binding SelectedContract.MonthlyCost}" Visibility="{Binding HideCosts}" Foreground="White" Margin="0,0,20,0"/>
                            <Label Content="Cost Per Job:" Foreground="#94A3B8"/>
                            <Label Content="{Binding SelectedContract.CostPerJob}" Visibility="{Binding HideCosts}" Foreground="White"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <StackPanel Grid.Row="1">
                    
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Button Grid.Row="0" Grid.Column="0" Content="Renew"  Style="{StaticResource btnRenew}" Command="{Binding RenewContractCommand}" IsEnabled="{Binding DisableItemsForNewContract}"  Height="30" Margin="5"/>
                        <Button Grid.Row="1" Grid.Column="0" Content="Delete"  Style="{StaticResource btnDelete}" Command="{Binding DeleteContractCommand}" Height="30" Margin="5" />
                        <Button Grid.Row="0" Grid.Column="1" Content="Update"  Style="{StaticResource btnUpdate}" Command="{Binding UpdateContractCommand}" Height="30" Margin="5"/>
                        <Button Grid.Row="1" Grid.Column="1" Content="Add"  Style="{StaticResource btnAdd}" Command="{Binding AddContractCommand}" IsEnabled="{Binding EnableItemsForNewContract}" Height="30" Margin="5" />
                    </Grid>
                </StackPanel>
            </Grid>
           
        </Border>
        
    </Grid>
</UserControl>
