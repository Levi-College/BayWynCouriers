<UserControl x:Class="BayWyn_Couriers.Views.AdminJobs"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:BayWyn_Couriers.ViewModels" 
             d:DataContext="{d:DesignInstance Type=vm:AdminVM}"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox ItemsSource="{Binding JobsFilterList}" SelectedItem="{Binding SelectedJobStatus}" Style="{StaticResource ModernComboBoxStyle}" Width="150" Height="35" Margin="0,0,10,0" VerticalContentAlignment="Center"/>
                <Button Content="Refresh" Command="{Binding RefreshJobsCommand}" Style="{StaticResource PageButton}"/>
            </StackPanel>

            <Button Content="+ New Job" Command="{Binding NewJobCommand}" Style="{StaticResource NewJobButton}"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="0,0,20,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" Direction="270" ShadowDepth="2" Opacity="0.05"/>
                </Border.Effect>

                <DataGrid ItemsSource="{Binding AllJobs}" SelectedItem="{Binding SelectedJob}" Style="{StaticResource MainDataGridStyle}">
                    
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding JobId}" Width="50"/>
                        
                        
                        <DataGridTemplateColumn Header="Client" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ClientName}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="5,0" TextWrapping="Wrap" Background="Transparent"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Date Created" Binding="{Binding StartDate, StringFormat=d}" Width="*"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding JobStatus}" Width="100"/>
                    </DataGrid.Columns>
                    
                    
                </DataGrid>
            </Border>

            <Border Grid.Column="1" Background="#1A1F26" CornerRadius="10" Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" Direction="270" ShadowDepth="2" Opacity="0.05"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Job Details" FontSize="18" FontWeight="Bold" Margin="0,0,0,20" Foreground="White"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Client" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding ClientList}" SelectedItem="{Binding SelectedClient}" Style="{StaticResource ModernComboBoxStyle2}"
                                      DisplayMemberPath="Name" Margin="0,0,0,10" Height="35" IsEnabled="{Binding EnableItemsForNewJob}"/>


                            <Label Content="Courier Name:" Foreground="#94A3B8"/>
                            <TextBox x:Name="txtCourierName" Margin="0,0,0,10" Text="{Binding SelectedCourier.UserName, Mode=TwoWay}" Style="{StaticResource InputTextBox}" IsEnabled="False"/>
                    
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Label Content="Start Date:" Grid.Row="0" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                <TextBox Grid.Row="1" IsEnabled="False" Margin="5,0,5,5" Style="{StaticResource InputTextBox}" Text="{Binding SelectedJob.StartDate, StringFormat=d, Mode=TwoWay}" />

                                <Label Content="End Date:" Grid.Row="0" Grid.Column="1" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                <TextBox Margin="5,0,5,5" Grid.Row="1" Grid.Column="1" IsEnabled="False" Style="{StaticResource InputTextBox}" Text="{Binding SelectedJob.EndDate, StringFormat=d, Mode=TwoWay}" />
                            </Grid>


                            <TextBlock Text="Delivery Address" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding SelectedJob.DeliveryAddress}" Style="{StaticResource InputTextBox}" Height="60" TextWrapping="Wrap" Margin="0,0,0,15"/>

                            <TextBlock Text="Description" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,5"/>

                            <TextBox Text="{Binding SelectedJob.Description}" Style="{StaticResource InputTextBox}" Height="60" TextWrapping="Wrap" Margin="0,0,0,15"/>

                            <Grid Margin="0,5">
                                <StackPanel>
                                    <TextBlock Text="Total Cost" FontSize="11" Foreground="White"/>
                                    <TextBlock Text="{Binding CostOfJob, StringFormat='{}{0:C}', ConverterCulture='en-GB'}" FontSize="20" FontWeight="Bold" Foreground="White"/>

                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Margin="0,20,0,0">
                        <Button Content="Update/Approve" Command="{Binding UpdateJobCommand}" IsEnabled="{Binding DisableItemsForNewJob}" Height="40" Style="{StaticResource btnUpdate}" FontWeight="Bold" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="Delete" Command="{Binding DeleteJobCommand}" IsEnabled="{Binding DisableItemsForNewJob}" Grid.Column="0" Margin="0,0,5,0" Height="35"  Style="{StaticResource btnDelete}"/>
                            <Button Content="Add New" Command="{Binding AddJobCommand}" Grid.Column="1" Margin="5,0,0,0" Height="35" Style="{StaticResource btnAdd}" IsEnabled="{Binding EnableItemsForNewJob}"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>