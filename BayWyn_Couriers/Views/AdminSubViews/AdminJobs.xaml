<UserControl x:Class="BayWyn_Couriers.Views.AdminJobs"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BayWyn_Couriers.Views"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="800">
    <Grid Background="AntiqueWhite">

        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!--Filter and date picker-->
        <ComboBox Grid.Row="0" Grid.Column="0" Margin="10" Width="150" HorizontalAlignment="Left" VerticalAlignment="Center">
            <ComboBoxItem Content="All Jobs"/>
            <ComboBoxItem Content="Pending Jobs"/>
            <ComboBoxItem Content="Completed Jobs"/>
        </ComboBox>

        <DatePicker Grid.Row="0" Grid.Column="0" Margin="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>

        <!--Data grid for the jobs to be displayed-->

        <!--Data grid for the jobs to be displayed-->
        <DataGrid ItemsSource="{Binding PendingJobs}" Grid.Row="1" Grid.Column="0" x:Name="jobsList" />

        <StackPanel Grid.Row="1" Grid.Column="1" Background="Blue">
            <TextBlock Text="Job Details" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" TextWrapping="Wrap"/>
            <TextBlock Text="This is where job details and management features will be implemented." FontSize="16" TextWrapping="Wrap"/>
        </StackPanel>

    </Grid>
    
</UserControl>
