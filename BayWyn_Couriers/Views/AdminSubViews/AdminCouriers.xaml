<UserControl x:Class="BayWyn_Couriers.Views.AdminSubViews.AdminCouriers"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BayWyn_Couriers.Views.AdminSubViews"
             xmlns:vm="clr-namespace:BayWyn_Couriers.ViewModels" d:DataContext="{d:DesignInstance Type=vm:AdminVM}"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <StackPanel HorizontalAlignment="Right">
            <Button Content="Refresh List" Style="{StaticResource PageButton}" Command="{Binding RefreshCouriersCommand}" Width="120"/>
        </StackPanel>
        
        
        <TextBlock Grid.Row="0" Grid.Column="1" Foreground="White" Text="Courier Details" FontSize="26" FontWeight="Bold" 
       HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <!--Data grid for the Contracts to be displayed-->
        <Border Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Direction="270" ShadowDepth="2" Opacity="0.05"/>
            </Border.Effect>
            <DataGrid ItemsSource="{Binding CouriersList}" Style="{StaticResource MainDataGridStyle}"
                      SelectedItem="{Binding SelectedCourier}" AutoGenerateColumns="False" IsReadOnly="True">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding UserId}" Width="50"/>
                    <DataGridTextColumn Header="Courier Name" Binding="{Binding Name}" Width="2*"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Background="#1A1F26" CornerRadius="10" Padding="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Direction="270" ShadowDepth="2" Opacity="0.05"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                        <Label Content="Courier ID:" Style="{StaticResource LabelStyle}" Grid.Column="0"/>
                        <TextBox Style="{StaticResource InputTextBox}" Text="{Binding SelectedCourier.UserId}" IsReadOnly="True" 
                                FontWeight="Bold" Grid.Column="1"/>


                        <Label Content="User Name:"  Grid.Row="1" Grid.Column="0"  Style="{StaticResource LabelStyle}"/>
                        <TextBox Style="{StaticResource InputTextBox}" Grid.Row="1" Grid.Column="1" Text="{Binding SelectedCourier.UserName}" />

                        <Label Content="Full Name:"  Grid.Row="2" Grid.Column="0"  Style="{StaticResource LabelStyle}"/>
                        <TextBox Style="{StaticResource InputTextBox}" Grid.Row="2" Grid.Column="2" Text="{Binding SelectedCourier.Name}" />


                        <StackPanel Grid.Row="3" Grid.ColumnSpan="2">
                            <Label Content="Contact Email Address:"  Style="{StaticResource LabelStyle}"/>
                            <TextBox  Grid.ColumnSpan="2" Text="{Binding SelectedCourier.Email}" Style="{StaticResource InputTextBox}" />
                        </StackPanel>
                            
                        <StackPanel Grid.Row="4" Grid.ColumnSpan="2">
                            <Label Content="Phone:"  Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding SelectedCourier.PhoneNumber}" Style="{StaticResource InputTextBox}" InputScope="TelephoneNumber"/>
                        </StackPanel>


                        <StackPanel Grid.Row="5" Grid.ColumnSpan="2">
                            <Label Content="Address:"  Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding SelectedCourier.Address}" Style="{StaticResource InputTextBox}" Height="47" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Button Grid.Column="0" Content="Delete" Margin="0,0,5,0" 
                        Command="{Binding DeleteCourierCommand}" 
                        FontWeight="Bold"/>

                    <Button Content="Update" Grid.Column="1" Margin="0,0,5,0"
                        Command="{Binding UpdateCourierCommand}" />
                </Grid>

            </Grid>
        </Border>
    </Grid>
</UserControl>
