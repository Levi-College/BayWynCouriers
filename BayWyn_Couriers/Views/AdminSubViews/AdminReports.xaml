<UserControl x:Class="BayWyn_Couriers.Views.AdminSubViews.AdminReports"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BayWyn_Couriers.Views.AdminSubViews" 
             xmlns:viewmodels="clr-namespace:BayWyn_Couriers.ViewModels" 
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             d:DataContext="{d:DesignInstance Type=viewmodels:AdminVM}"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">


    <Grid Background="AntiqueWhite" Margin="5">

        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!--<DatePicker Grid.Row="0" Grid.Column="0" Margin="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>-->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="CHOOSE REPORT" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10"/>

        <!--Header for the edit column-->
        <TextBlock Grid.Row="0" Grid.Column="1" Text="BAYWN COURIERS" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10"/>


        <Grid Grid.Row="1" Grid.Column="0">
            <StackPanel Orientation="Vertical">
                <StackPanel.Resources>
                    <!-- A style that makes RadioButtons look like Menu Buttons -->
                    <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                        <Setter Property="Height" Value="40"/>
                        <Setter Property="Margin" Value="0,5,5,5"/>
                        <Setter Property="Background" Value="#F0F0F0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <!-- Highlighting the selected menu item -->
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="Background" Value="#007BFF"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </StackPanel.Resources>

                <!-- Use IsChecked="True" on the first one to select it by default -->
                <RadioButton Content="Day Jobs (Courier Based)" Command="{Binding DayJobsReportCommand}"/>
                <RadioButton Content="Monthly Jobs (Courier Based)" Command="{Binding MonthlyJobsReportCommand}"/>
                <RadioButton Content="All Jobs (Client based)" Command="{Binding ContractsJobReportCommand}"/>
                <RadioButton Content="Monthly Value (Client based)" Command="{Binding ClientsValueReportCommand}"/>
            </StackPanel>
        </Grid>
    

        <Grid Grid.Row="1" Grid.Column="1" Width="350">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!--Report details window-->
            <StackPanel>
                
            </StackPanel>
            
            <!-- Report Window-->
            
            <!--Day jobs report-->
            <StackPanel Visibility="{Binding DayReportVisibility}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <StackPanel Grid.Column="1">
                            <ComboBox ItemsSource="{Binding CouriersList}" 
                                      SelectedItem="{Binding SelectedCourier, UpdateSourceTrigger=PropertyChanged}" 
                                      DisplayMemberPath="UserName" SelectedValuePath="UserId"/>
                        </StackPanel>
                    </Grid>

                    <DatePicker SelectedDate="{Binding DateForDayJobReport, UpdateSourceTrigger=PropertyChanged}"  DisplayDate="{x:Static sys:DateTime.Now}" Grid.Column="1"/>

                </Grid>
            </StackPanel>

            <!--Monthly jobs report--><!--
            <StackPanel Visibility="{Binding MonthlyReportVisibility}">
                <TextBlock Text="Monthly Courier Jobs"/>
            </StackPanel>

            --><!--All jobs report--><!--
            <StackPanel Visibility="{Binding AllJobsReportVisibility}">
                <TextBlock Text="All Monthly Jobs"/>
            </StackPanel>

            --><!--Monthly value report--><!--
            <StackPanel Visibility="{Binding MonthlyValueReportVisibility}">
                <TextBlock Text="Client Value Report"/>
            </StackPanel>-->

            <StackPanel Grid.Row="1">
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,20,0,0">
                    <ItemsControl ItemsSource="{Binding DailyReportJobs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E0E0E0" BorderThickness="1,1,1,4" Margin="0,5,5,10" Background="White">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DeliverySlot}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Slot" FontSize="10" Foreground="Gray" HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="15,0">
                                            <TextBlock Text="{Binding ClientName}" FontSize="16" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding DeliveryAddress}" TextWrapping="Wrap" Margin="0,4"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Grid>
    </Grid>



</UserControl>
