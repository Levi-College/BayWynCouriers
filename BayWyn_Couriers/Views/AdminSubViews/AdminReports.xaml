<UserControl x:Class="BayWyn_Couriers.Views.AdminSubViews.AdminReports"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BayWyn_Couriers.Views.AdminSubViews" 
             xmlns:viewmodels="clr-namespace:BayWyn_Couriers.ViewModels" 
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             d:DataContext="{d:DesignInstance Type=viewmodels:AdminVM}"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">


    <Grid Margin="5">

        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <TextBlock Grid.Row="0" Grid.Column="0" FontWeight="Bold" FontSize="18" Foreground="White" Text="Reports" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10"/>

        <!--Header for the edit column-->
        <TextBlock Grid.Row="0" Grid.Column="1" Text="BAYWN COURIERS" FontWeight="Bold" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10"/>

        <Grid Grid.Row="1" Grid.Column="0">
            <StackPanel Orientation="Vertical">
                <RadioButton Content="Day Jobs (Courier Based)" Command="{Binding DayJobsReportCommand}" Style="{StaticResource SidebarNavigationButtonStyle}"/>
                <RadioButton Content="Monthly Jobs (Courier Based)" Command="{Binding MonthlyJobsReportCommand}" Style="{StaticResource SidebarNavigationButtonStyle}"/>
                <RadioButton Content="All Jobs (Client based)" Command="{Binding ContractsJobReportCommand}" Style="{StaticResource SidebarNavigationButtonStyle}"/>
                <RadioButton Content="Monthly Value (Client based)" Command="{Binding ClientsValueReportCommand}" Style="{StaticResource SidebarNavigationButtonStyle}"/>
            </StackPanel>
        </Grid>
    

        <Grid Grid.Row="1" Grid.Column="1" Margin="10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="100"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            
            <!--Day jobs report-->
            <Grid Visibility="{Binding DayReportVisibility}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    
                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Daily Jobs Report" TextWrapping="Wrap" Grid.Column="0" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding CouriersList}" Style="{StaticResource ModernComboBoxStyle2}"
                                      SelectedItem="{Binding SelectedCourier, UpdateSourceTrigger=PropertyChanged}" 
                                      DisplayMemberPath="UserName" SelectedValuePath="UserId"/>
                        <DatePicker SelectedDate="{Binding DateForDayJobReport, UpdateSourceTrigger=PropertyChanged}"  DisplayDate="{x:Static sys:DateTime.Now}" Grid.Column="2"/>
       
                    </Grid>
 
                    <Button  Grid.Row="2" Grid.ColumnSpan="2" Content="Generate Report" Command="{Binding GenerateDayJobsReportCommand}" Style="{StaticResource NewJobButton}" HorizontalAlignment="Center"/>
                </Grid>
            </Grid>

            <!--Monthly jobs report-->
            <StackPanel Visibility="{Binding MonthlyReportVisibility}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="50"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Monthly Courier Report" TextWrapping="Wrap" Grid.Column="0" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    
                    <Button Grid.Row="1" Content="Generate Report" Command="{Binding GenerateMonthlyJobsReportCommand}" HorizontalAlignment="Center" Margin="0" Style="{StaticResource NewJobButton}"/>
                    
                </Grid>
                
            </StackPanel>

            <!--All jobs report-->

            <Grid Visibility="{Binding AllJobsReportVisibility}">
             
                    <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="All Jobs Report" TextWrapping="Wrap" Grid.Column="0" Foreground="White" HorizontalAlignment="Center"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                 
                    <ComboBox Grid.Column="0" Margin="5,0" ItemsSource="{Binding MonthsList}" SelectedItem="{Binding SelectedMonthForReport}" Style="{StaticResource ModernComboBoxStyle2}"/>
                    <ComboBox Grid.Column="1" Margin="5,0" ItemsSource="{Binding YearsList}" SelectedItem="{Binding SelectedYearForReport}" Style="{StaticResource ModernComboBoxStyle2}"/>
   
                </Grid>

                <Grid Grid.Row="2">
                    <Button HorizontalAlignment="Center" Content="Generate Report" Command="{Binding GenerateAllJobsReportCommand}" Style="{StaticResource NewJobButton}"/>
                </Grid>
                
            </Grid>

            <!--Monthly value report-->
            <Grid Visibility="{Binding MonthlyValueReportVisibility}">

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Client Value Report" TextWrapping="Wrap" Grid.Column="0" Foreground="White" HorizontalAlignment="Center"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0" Margin="5,0" ItemsSource="{Binding MonthsList}"  SelectedItem="{Binding SelectedMonthForReport}" Style="{StaticResource ModernComboBoxStyle2}"/>
                    <ComboBox Grid.Column="1" Margin="5,0" ItemsSource="{Binding YearsList}" SelectedItem="{Binding SelectedYearForReport}" Style="{StaticResource ModernComboBoxStyle2}"/>

                </Grid>

                <Grid Grid.Row="2">
                    <Button Content="Generate Report" Command="{Binding GenerateValueReportCommand}" Style="{StaticResource NewJobButton}" HorizontalAlignment="Center"/>
                </Grid>
            </Grid>

            
            <!--Reports-->
            <Grid Grid.Row="1" Visibility="{Binding DayReportVisibility}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,20,0,0">
                    <ItemsControl ItemsSource="{Binding ReportJobs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1A1F26" CornerRadius="8" Margin="0,0,10,10" Padding="15">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" Direction="270" ShadowDepth="2" Opacity="0.1"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DeliverySlot}" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Slot" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="20,0">
                                            <TextBlock Text="{Binding ClientName}" FontSize="16" FontWeight="Bold" Foreground="#9D7BFF"/>
                                            <TextBlock Text="{Binding DeliveryAddress}" TextWrapping="Wrap" Foreground="White" Margin="0,4"/>
                                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#94A3B8" FontStyle="Italic"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <Grid Grid.Row="1" Visibility="{Binding MonthlyReportVisibility}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,20,0,0">
                    <ItemsControl ItemsSource="{Binding GroupedMonthlyReport}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander Margin="0,0,10,10" Background="#1A1F26" Foreground="White" BorderThickness="0">
                                    <Expander.Header>
                                        <TextBlock Text="{Binding GroupName}" FontWeight="Bold" FontSize="14" Foreground="#9D7BFF" Margin="10,0"/>
                                    </Expander.Header>

                                    <ItemsControl ItemsSource="{Binding GroupJobs}" Margin="10,5">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#2B1D42" BorderThickness="0,0,0,1" Margin="5" Padding="10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                           
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

        

                                                        <StackPanel Grid.Column="0" Margin="10,0">
                                                            <TextBlock Text="{Binding ClientName}" Foreground="White" FontWeight="Bold"/>
                                                            <TextBlock Text="{Binding DeliveryAddress}" Foreground="#94A3B8" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>

                                                        <TextBlock Grid.Column="1" Text="{Binding EndDate, StringFormat=d}" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

     

            <Grid Grid.Row="1" Visibility="{Binding AllJobsReportVisibility}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,20,0,0">
                    <ItemsControl ItemsSource="{Binding GroupedMonthlyClientReport}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander Margin="0,0,10,15" Background="#1A1F26" BorderThickness="0">
                                    <Expander.Header>
                                        <Grid Width="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ContentPresenter}, Path=ActualWidth}" Margin="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                               
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding ClientName}" Foreground="#9D7BFF" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                                                <TextBlock Text="|" Foreground="#334155" Margin="10,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding ClientEmail}" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>

                            
                                        </Grid>
                                    </Expander.Header>

                                    <ItemsControl ItemsSource="{Binding ClientJobs}" Margin="10,5,10,10">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#0B0E14" CornerRadius="8" Margin="0,5" Padding="12">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <!--<ColumnDefinition Width="85"/>-->
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0" Margin="15,0">
                                                            <TextBlock Text="{Binding DeliveryAddress}" Foreground="White" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="Job ID: " Foreground="#94A3B8" FontSize="11"/>
                                                                <TextBlock Text="{Binding JobID}" Foreground="#9D7BFF" FontSize="11" FontWeight="SemiBold" Margin="0,0,15,0"/>
                                                                <TextBlock Text="Date Created: " Foreground="#94A3B8" FontSize="11"/>
                                                                <TextBlock Text="{Binding DateCreated, StringFormat=d}" Foreground="White" FontSize="11"/>
                                                            </StackPanel>
                                                        </StackPanel>

                                           
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <Grid Grid.Row="1" Visibility="{Binding MonthlyValueReportVisibility}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,20,0,0">
                    <ItemsControl ItemsSource="{Binding MonthlyClientValueReportList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1A1F26" CornerRadius="10" Margin="0,0,10,12" Padding="20">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                  

                                        <StackPanel>
                                            <TextBlock Text="{Binding ClientId, StringFormat='ID: {0}'}" FontSize="10" Foreground="#94A3B8" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" Foreground="White" />
                                            <TextBlock Text="{Binding Email}" Foreground="#94A3B8" FontSize="12" Margin="0,2,0,0"/>
                                            <Border Style="{StaticResource StatusBadgeBorderStyle}" Margin="0,5,0,5">
                                                <TextBlock Text="{Binding ContractStatus}" Style="{StaticResource StatusBadgeTextStyle}"/>
                                            </Border>
                                            <Grid Margin="0,5,0,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="Total Value" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="11" Margin="0,0,10,0"/>
                                                <Border  Grid.Row="1" Background="#2B1D42" Padding="12,6" CornerRadius="6">
                                                    <TextBlock Text="{Binding MonthlyValue, StringFormat='{}{0:C}', ConverterCulture='en-GB'}" Foreground="#9D7BFF" FontWeight="Bold" FontSize="16" />
                                                </Border>
                                            </Grid>
                                        </StackPanel>

                             
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
</Grid>



</UserControl>
