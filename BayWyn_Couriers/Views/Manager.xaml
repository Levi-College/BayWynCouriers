<UserControl x:Class="BayWyn_Couriers.Views.Manager"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BayWyn_Couriers.Views" 
             xmlns:viewmodels="clr-namespace:BayWyn_Couriers.ViewModels" 
             d:DataContext="{d:DesignInstance Type=viewmodels:ManagerVM}"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1000">

    <Grid Style="{StaticResource AdminBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Side Menu -->
        <Grid Grid.Column="0"  Style="{StaticResource GenericBackground}">

            <Grid.RowDefinitions>
                <RowDefinition Height="80"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                <StackPanel>
                    <TextBlock Text="BayWyn Couriers" FontWeight="Bold" FontSize="18" Foreground="White"/>
                    <TextBlock Text="Courier Management System" FontSize="10" Foreground="#94A3B8" Margin="0,-2,0,0"/>
                </StackPanel>
            </StackPanel>
            
            <!-- Use IsChecked="True" on the first one to select it by default -->
            <StackPanel Grid.Row="1" Margin="10,20,10,0" >
                <RadioButton Content="View Jobs" Command="{Binding ManagerJobsCommand}" IsChecked="True" Style="{StaticResource SidebarNavigationButtonStyle}"/>
                <RadioButton Content="View Reports" Command="{Binding ReportsCommand}" Style="{StaticResource SidebarNavigationButtonStyle}"/>
                <RadioButton Content="View Contracts" Command="{Binding ManagerContractsCommand}" Style="{StaticResource SidebarNavigationButtonStyle}"/>
                <RadioButton Content="View Clients" Command="{Binding ManagerClientsCommand}" Style="{StaticResource SidebarNavigationButtonStyle}"/>
                <RadioButton Content="View Couriers" Command="{Binding ManagerCouriersCommand}" Style="{StaticResource SidebarNavigationButtonStyle}"/>
            </StackPanel>

          
                  
        </Grid>

        <!-- Main Content Area -->
        <Grid Grid.Column="1" Background="#1A1F26">
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,1" Background="#1A1F26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Manager Dashboard" VerticalAlignment="Center" Margin="30,0" FontSize="22" FontWeight="Bold" Foreground="White"/>
                <StackPanel Grid.Column="1" Orientation="Vertical" Margin="0,0,30,0">
                    <Button Content="Logout" Command="{Binding LogoutCommand}" Width="80" Height="30"/>
                </StackPanel>
            </Grid>
            
            <Border Grid.Row="1" Style="{StaticResource SubViewBorder}">
                <ContentControl Content="{Binding CurrentSubView}"/>
            </Border>

        </Grid>
    </Grid>
</UserControl>
