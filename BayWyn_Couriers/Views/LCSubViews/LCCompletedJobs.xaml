<UserControl x:Class="BayWyn_Couriers.Views.LCSubViews.LCCompletedJobs"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BayWyn_Couriers.Views.LCSubViews" 
             xmlns:viewmodels="clr-namespace:BayWyn_Couriers.ViewModels" 
             d:DataContext="{d:DesignInstance Type=viewmodels:LCVM}"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">

    <Grid Margin="10">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="0,0,20,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" Direction="270" ShadowDepth="2" Opacity="0.05"/>
                </Border.Effect>

                <DataGrid ItemsSource="{Binding AllJobs}" 
                          SelectedItem="{Binding SelectedJob, Mode=TwoWay}" 
                          Style="{StaticResource MainDataGridStyle}"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding JobId}" Width="60"/>
                        <DataGridTextColumn Header="Address" Binding="{Binding DeliveryAddress}" Width="*"/>
                        <DataGridTextColumn Header="Completed Date" Binding="{Binding EndDate, StringFormat=d}" Width="120"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding JobStatus}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="1" Background="#1A1F26" CornerRadius="10" Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" Direction="270" ShadowDepth="2" Opacity="0.05"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Archive Details" FontSize="18" FontWeight="Bold" Margin="0,0,0,20" Foreground="White"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Job ID" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding SelectedJob.JobId}" Foreground="White" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>

                            <TextBlock Text="Delivered By" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding SelectedCourier.UserName}" Foreground="White" FontSize="13" Margin="0,0,0,15"/>

                            <TextBlock Text="Delivered On" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding SelectedJob.EndDate, StringFormat=D}" Foreground="White" FontSize="13" Margin="0,0,0,15"/>

                            <TextBlock Text="Delivery Address" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding SelectedJob.DeliveryAddress}" 
                                     Style="{StaticResource InputTextBox}" 
                                     IsReadOnly="True"
                                     Height="50" TextWrapping="Wrap" Margin="0,0,0,15" Background="#242B35"/>

                            <TextBlock Text="Job Description" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding SelectedJob.Description}" 
                                     Style="{StaticResource InputTextBox}" 
                                     IsReadOnly="True"
                                     Height="60" TextWrapping="Wrap" Margin="0,0,0,15" Background="#242B35"/>

                            <Border Background="#064E3B" CornerRadius="5" Padding="10" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SelectedJob.JobStatus}" Foreground="#10B981" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>