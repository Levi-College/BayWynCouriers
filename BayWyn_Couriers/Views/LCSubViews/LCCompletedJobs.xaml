<UserControl x:Class="BayWyn_Couriers.Views.LCSubViews.LCCompletedJobs"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BayWyn_Couriers.Views.LCSubViews" 
             xmlns:viewmodels="clr-namespace:BayWyn_Couriers.ViewModels" 
             d:DataContext="{d:DesignInstance Type=viewmodels:LCVM}"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">

    <UserControl.Resources>
        <Style TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>
    </UserControl.Resources>
    
    
    <Grid Background="AntiqueWhite" Margin="5">

        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Structure to hold the edit window and the buttons-->

        <!--Header for the edit column-->
        <TextBlock Grid.Row="0" Grid.Column="1" Text="Edit/New" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10"/>

        <!--Data grid for the jobs to be displayed-->
        <DataGrid AutoGenerateColumns="False"
        ItemsSource="{Binding AllJobs}" 
        SelectedItem="{Binding Path=SelectedJob, Mode=TwoWay}"
        IsReadOnly="True"
        Grid.Row="1" Grid.Column="0">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Job ID" Binding="{Binding JobId}" Width="Auto"/>
                <DataGridTextColumn Header="Address" Binding="{Binding DeliveryAddress}" Width="*"/>
                <DataGridTextColumn Header="Start Date" Binding="{Binding StartDate, StringFormat=d}" Width="*"/>
                <DataGridTextColumn Header="Status" Binding="{Binding JobStatus}" Width="*"/>
            </DataGrid.Columns>

        </DataGrid>


        <Grid Grid.Row="1" Grid.Column="1" Width="350">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <!-- Edit section for the selected job -->
            <StackPanel Grid.Row="0">

                <StackPanel Orientation="Horizontal">
                    <Label Content="Job ID:"/>
                    <Label x:Name="txtJobID" Content="{Binding SelectedJob.JobId, Mode=OneWay}" Width="50"/>
                </StackPanel>


                <Label Content="Courier Name:"/>
                <TextBox Text="{Binding SelectedCourier.UserName}"/>
                
                <Label Content="Delivered On:"/>
                <TextBox Text="{Binding SelectedJob.EndDate, StringFormat=d}"/>
     

                <Label Content="Delivered Address:"/>
                <TextBox x:Name="txtDeliveryAddress" Margin="0,0,0,10" Text="{Binding SelectedJob.DeliveryAddress}" Height="51"/>

                <Label Content="Description:"/>
                <TextBox x:Name="txtDescription" Margin="0,0,0,10" TextWrapping="Wrap" Text="{Binding SelectedJob.Description}" Height="49"/>

                <StackPanel Orientation="Horizontal" >
                    <Label Content="Status:"/>
                    <TextBox Text="{Binding SelectedJob.JobStatus}" Width="200"/>
                </StackPanel>



            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Update" Command="{Binding AssignJobCommand}" Width="100" Margin="5"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
