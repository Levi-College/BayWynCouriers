<UserControl x:Class="BayWyn_Couriers.Views.LCSubViews.LCAssignedJobs"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BayWyn_Couriers.Views.LCSubViews" 
             xmlns:viewmodels="clr-namespace:BayWyn_Couriers.ViewModels" 
             d:DataContext="{d:DesignInstance Type=viewmodels:LCVM}"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Currently Assigned Jobs" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="0,0,20,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" Direction="270" ShadowDepth="2" Opacity="0.05"/>
                </Border.Effect>

                <DataGrid ItemsSource="{Binding AllJobAssignments}" 
                          SelectedItem="{Binding SelectedJobAssignment, Mode=TwoWay}" 
                          Style="{StaticResource MainDataGridStyle}"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Job ID" Binding="{Binding JobId}" Width="60"/>
                        <DataGridTextColumn Header="Courier ID" Binding="{Binding CourierId}" Width="80"/>

                        <DataGridTemplateColumn Header="Delivery Address" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DeliveryAddress}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="5"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Start Date" Binding="{Binding StartDate, StringFormat=d}" Width="*"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding JobStatus}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="1" Background="#1A1F26" CornerRadius="10" Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" Direction="270" ShadowDepth="2" Opacity="0.05"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Assignment Details" FontSize="18" FontWeight="Bold" Margin="0,0,0,20" Foreground="White"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Job ID" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding SelectedJobAssignment.JobId}" Foreground="White" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>

                            <TextBlock Text="Assigned Courier" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding SelectedCourier.UserName}" Foreground="White" FontSize="13" Margin="0,0,0,15"/>

                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Delivery Date" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding SelectedJobAssignment.DeliveryDate, StringFormat=d}" Foreground="White" FontSize="12"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Time Slot" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding SelectedJobAssignment.DeliverySlot}" Foreground="White" FontSize="12"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Delivery Address" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,5"/>
                            <TextBox x:Name="txtDeliveryAddress" 
                                     Text="{Binding SelectedJobAssignment.DeliveryAddress, Mode=TwoWay}" 
                                     Style="{StaticResource InputTextBox}" 
                                     Height="60" TextWrapping="Wrap" Margin="0,0,0,15"/>

                            <TextBlock Text="Description" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,5"/>
                            <TextBox x:Name="txtDescription" 
                                     Text="{Binding SelectedJobAssignment.Description, Mode=TwoWay}" 
                                     Style="{StaticResource InputTextBox}" 
                                     Height="60" TextWrapping="Wrap" Margin="0,0,0,15"/>

                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                <TextBlock Text="Job Status: " FontSize="11" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding SelectedJobAssignment.JobStatus}" FontSize="11" Foreground="#FACC15" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Margin="0,20,0,0">
                        <Button Content="UnAssign Job" 
                                Command="{Binding UnAssignJobCommand}" 
                                Height="45" 
                                 Style="{StaticResource btnDelete}"
                                FontWeight="Bold" 
                                BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>