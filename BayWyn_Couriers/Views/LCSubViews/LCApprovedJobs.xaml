<UserControl x:Class="BayWyn_Couriers.Views.LCSubViews.LCApprovedJobs"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BayWyn_Couriers.Views.LCSubViews" 
             xmlns:viewmodels="clr-namespace:BayWyn_Couriers.ViewModels" 
             d:DataContext="{d:DesignInstance Type=viewmodels:LCVM}"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Approved Jobs Assignment" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="0,0,20,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" Direction="270" ShadowDepth="2" Opacity="0.05"/>
                </Border.Effect>

                <DataGrid ItemsSource="{Binding AllJobs}" 
                          SelectedItem="{Binding SelectedJob, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                          Style="{StaticResource MainDataGridStyle}"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding JobId}" Width="50"/>
                        <DataGridTemplateColumn Header="Delivery Address" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DeliveryAddress}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="5"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Date Created" Binding="{Binding StartDate, StringFormat=d}" Width="100"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding JobStatus}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="1" Background="#1A1F26" CornerRadius="10" Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" Direction="270" ShadowDepth="2" Opacity="0.05"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Assign Job" FontSize="18" FontWeight="Bold" Margin="0,0,0,20" Foreground="White"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                <TextBlock Text="Editing Job ID: " Foreground="#94A3B8" FontSize="12"/>
                                <TextBlock Text="{Binding SelectedJob.JobId}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                            </StackPanel>

                            <TextBlock Text="Courier" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding CouriersList}" 
                                      SelectedItem="{Binding SelectedCourier, Mode=TwoWay}" 
                                      DisplayMemberPath="UserName" 
                                      SelectedValuePath="UserId"
                                      Style="{StaticResource ModernComboBoxStyle2}"
                                      IsEnabled="{Binding EnableCourierSelection}"
                                      Height="35" Margin="0,0,0,15"/>

                            <TextBlock Text="Delivery Date" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,5"/>

                            <DatePicker SelectedDate="{Binding SelectedDeliveryDate, UpdateSourceTrigger=PropertyChanged}" 
                                        IsEnabled="{Binding DatePickerEnabled}"/>

                            <TextBlock Text="Time Slot" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,5"/>
                            <Expander Header="Select Delivery Time Slot" 
                                      Background="#2D3748" Foreground="White" 
                                      BorderThickness="0"
                                      IsEnabled="{Binding TimePickerEnabled}"
                                      Margin="0,0,0,15">
                                <ItemsControl ItemsSource="{Binding TimeSlots}" Margin="5">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="3"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <RadioButton Content="{Binding DisplayName}"
                                                         GroupName="Slots"
                                                         IsChecked="{Binding IsSelected}"
                                                         IsEnabled="{Binding IsEnabled}"
                                                         Style="{StaticResource {x:Type ToggleButton}}" 
                                                         Margin="2" Padding="5" FontSize="10"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>

                            <TextBlock Text="Delivery Address" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding SelectedJob.DeliveryAddress}" 
                                     Style="{StaticResource InputTextBox}" 
                                     Height="50" TextWrapping="Wrap" Margin="0,0,0,15"/>

                            <TextBlock Text="Description" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding SelectedJob.Description}" 
                                     Style="{StaticResource InputTextBox}" 
                                     Height="50" TextWrapping="Wrap" Margin="0,0,0,15"/>

                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                <TextBlock Text="Current Status: " FontSize="11" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding SelectedJob.JobStatus}" FontSize="11" Foreground="#38BDF8" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Margin="0,20,0,0">
                        <Button Content="Confirm Assignment" 
                                Command="{Binding AssignJobCommand}" 
                                Height="45" 
                                Background="#38BDF8" 
                                Foreground="White" 
                                FontWeight="Bold" 
                                BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>