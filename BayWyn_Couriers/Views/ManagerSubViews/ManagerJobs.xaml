<UserControl x:Class="BayWyn_Couriers.Views.ManagerSubViews.ManagerJobs"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BayWyn_Couriers.Views.ManagerSubViews" 
             xmlns:viewmodels="clr-namespace:BayWyn_Couriers.ViewModels" 
             d:DataContext="{d:DesignInstance Type=viewmodels:ManagerVM}"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox ItemsSource="{Binding JobsFilterList}" 
                          SelectedItem="{Binding SelectedJobStatus, UpdateSourceTrigger=PropertyChanged}" 
                          Style="{StaticResource ModernComboBoxStyle}" Width="150" Height="35" 
                          Margin="0,0,10,0" VerticalContentAlignment="Center"/>

                <Button Content="Refresh" Command="{Binding RefreshJobsCommand}" Style="{StaticResource PageButton}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="0,0,20,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" Direction="270" ShadowDepth="2" Opacity="0.05"/>
                </Border.Effect>

                <DataGrid x:Name="jobsList" ItemsSource="{Binding AllJobs}" 
                          SelectedItem="{Binding Path=SelectedJob, Mode=TwoWay}" 
                          Style="{StaticResource MainDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding JobId}" Width="50"/>
                        <DataGridTemplateColumn Header="Client" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ClientName}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="5,0" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Date Created" Binding="{Binding StartDate, StringFormat=d}" Width="*"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding JobStatus}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="1" Background="#1A1F26" CornerRadius="10" Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" Direction="270" ShadowDepth="2" Opacity="0.05"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Job Details" FontSize="18" FontWeight="Bold" Margin="0,0,0,20" Foreground="White"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Job ID" Style="{StaticResource PlaceholderText}"/>
                            <TextBox Text="{Binding SelectedJob.JobId, Mode=OneWay}" Style="{StaticResource InputTextBox}" IsEnabled="False" Margin="0,0,0,10"/>

                            <TextBlock Text="Client Name" Style="{StaticResource PlaceholderText}"/>
                            <TextBox Text="{Binding SelectedJob.ClientName}" Style="{StaticResource InputTextBox}" IsEnabled="False" Margin="0,0,0,10"/>

                            <TextBlock Text="Assigned Courier" Style="{StaticResource PlaceholderText}"/>
                            <TextBox Text="{Binding SelectedCourier.UserName}" Style="{StaticResource InputTextBox}" IsEnabled="False" Margin="0,0,0,10"/>

                            <Grid Margin="0,5,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Start Date" Grid.Row="0" Grid.Column="0" Style="{StaticResource PlaceholderText}" HorizontalAlignment="Center"/>
                                <TextBox Grid.Row="1" Grid.Column="0" IsEnabled="False" Margin="0,0,5,0" Style="{StaticResource InputTextBox}" 
                                         Text="{Binding SelectedJob.StartDate, StringFormat=d}" HorizontalContentAlignment="Center"/>

                                <TextBlock Text="End Date" Grid.Row="0" Grid.Column="1" Style="{StaticResource PlaceholderText}" HorizontalAlignment="Center"/>
                                <TextBox Grid.Row="1" Grid.Column="1" IsEnabled="False" Margin="5,0,0,0" Style="{StaticResource InputTextBox}" 
                                         Text="{Binding SelectedJob.EndDate, StringFormat=d}" HorizontalContentAlignment="Center"/>
                            </Grid>

                            <TextBlock Text="Delivery Address" Style="{StaticResource PlaceholderText}"/>
                            <TextBox Text="{Binding SelectedJob.DeliveryAddress}" Style="{StaticResource InputTextBox}" 
                                     Height="60" TextWrapping="Wrap" IsReadOnly="True" Margin="0,0,0,10"/>

                            <TextBlock Text="Description" Style="{StaticResource PlaceholderText}"/>
                            <TextBox Text="{Binding SelectedJob.Description}" Style="{StaticResource InputTextBox}" 
                                     Height="60" TextWrapping="Wrap" IsReadOnly="True" Margin="0,0,0,10"/>

                            <TextBlock Text="Current Status" Style="{StaticResource PlaceholderText}"/>
                            <TextBox Text="{Binding SelectedJob.JobStatus}" Style="{StaticResource InputTextBox}" IsEnabled="False" Margin="0,0,0,15"/>

                            <Border Background="#2B1D42" CornerRadius="5" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="Total Revenue" FontSize="11" Foreground="#94A3B8"/>
                                    <TextBlock Text="{Binding CostOfJob, StringFormat='{}{0:C}', ConverterCulture='en-GB'}" 
                                               FontSize="22" FontWeight="Bold" Foreground="White"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>