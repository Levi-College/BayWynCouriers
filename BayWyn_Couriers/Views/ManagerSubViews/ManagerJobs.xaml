<UserControl x:Class="BayWyn_Couriers.Views.ManagerSubViews.ManagerJobs"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BayWyn_Couriers.Views.ManagerSubViews" 
             xmlns:viewmodels="clr-namespace:BayWyn_Couriers.ViewModels" 
             d:DataContext="{d:DesignInstance Type=viewmodels:ManagerVM}"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">


    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- Structure to hold the edit window and the buttons-->

        <!--Filter-->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <ComboBox ItemsSource="{Binding JobsFilterList}" SelectedItem="{Binding SelectedJobStatus, UpdateSourceTrigger=PropertyChanged}" 
                      Style="{StaticResource ModernComboBoxStyle}" Width="150" Height="35" 
                      Margin="0,0,10,0" VerticalContentAlignment="Center"/>

            <Button Content="Refresh" Command="{Binding RefreshJobsCommand}" Style="{StaticResource PageButton}"/>
        </StackPanel>

        <!--<ComboBox Grid.Row="0" Grid.Column="0" 
              ItemsSource="{Binding JobsFilterList}"
              SelectedItem="{Binding SelectedJobStatus, UpdateSourceTrigger=PropertyChanged}"
              Margin="10" Width="120" HorizontalAlignment="Left" VerticalAlignment="Center">
        </ComboBox>

        <Button Content="Refresh" Command="{Binding RefreshJobsCommand}" 
    HorizontalAlignment="Left" Width="126" Height="23" Margin="249,15,0,0" VerticalAlignment="Top"/>-->

        <!--Header for the edit column-->
        <TextBlock Grid.Row="0" Grid.Column="1" Text="Details" Foreground ="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10"/>


        <Grid Grid.Row="1" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            
            <Border Grid.Row="1" Grid.Column="0" Margin="0,0,20,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" Direction="270" ShadowDepth="2" Opacity="0.05"/>
                </Border.Effect>
            

            <!--Data grid for the jobs to be displayed-->
                <DataGrid  x:Name="jobsList" AutoGenerateColumns="False" ItemsSource="{Binding AllJobs}" 
                      SelectedItem="{Binding Path=SelectedJob, Mode=TwoWay}" 
                      Style="{StaticResource MainDataGridStyle}" IsReadOnly="True">

                    <DataGrid.Columns>
                    <DataGridTextColumn Header="Job ID" Binding="{Binding JobId}" Width="Auto"/>
                    <!--<DataGridTextColumn Header="Client" Binding="{Binding ClientName}" Width="*"/>-->
                    <DataGridTemplateColumn Header="Client" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ClientName}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="5,0" TextWrapping="Wrap" Background="Transparent"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Date Created" Binding="{Binding StartDate, StringFormat=d}" Width="*"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding JobStatus}" Width="*"/>
                </DataGrid.Columns>

            </DataGrid>
            </Border>

            <Border Grid.Row="1" Grid.Column="1" Background="#1A1F26" CornerRadius="10" Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" Direction="270" ShadowDepth="2" Opacity="0.05"/>
                </Border.Effect>

                <Grid Grid.Row="1" Grid.Column="1">
                    <!-- Edit section for the selected job -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Label Content="Job ID:" Style="{StaticResource LabelStyle}"/>
                                <Label x:Name="txtJobID" Content="{Binding SelectedJob.JobId, Mode=OneWay}" Width="50" Style="{StaticResource LabelBox}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <Label Content="Client Name:" Style="{StaticResource LabelStyle}"/>
                                <Label Content="{Binding SelectedJob.ClientName}" Style="{StaticResource LabelBox}"/>
                            </StackPanel>


                            <StackPanel Orientation="Horizontal">
                                <Label Content="Courier Name:" Style="{StaticResource LabelStyle}"/>
                                <Label Content="{Binding SelectedCourier.UserName}" Style="{StaticResource LabelBox}"/>
                            </StackPanel>


                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Label Content="Start Date:" Grid.Row="0" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                <TextBox Grid.Row="1" IsEnabled="False" Margin="5,0,5,5" Style="{StaticResource InputTextBox}" Text="{Binding SelectedJob.StartDate, StringFormat=d, Mode=TwoWay}" />

                                <Label Content="End Date:" Grid.Row="0" Grid.Column="1" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                <TextBox Margin="5,0,5,5" Grid.Row="1" Grid.Column="1" IsEnabled="False" Style="{StaticResource InputTextBox}" Text="{Binding SelectedJob.EndDate, StringFormat=d, Mode=TwoWay}" />
                            </Grid>
                            
                            <!--<StackPanel Orientation="Horizontal">
                                <Label Content="Start Date:" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="txtDateCreated" IsEnabled="False" Margin="0,0,0,10" Text="{Binding SelectedJob.StartDate, StringFormat=d, Mode=TwoWay}" Style="{StaticResource InputTextBox}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <Label Content="End Date:" Style="{StaticResource LabelStyle}"/>
                                <TextBox Margin="0,0,0,10" IsEnabled="False" Text="{Binding SelectedJob.EndDate, StringFormat=d, Mode=TwoWay}" Style="{StaticResource InputTextBox}" />
                            </StackPanel>-->

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Total Cost" Style="{StaticResource PlaceholderText}"/>
                                <TextBlock Text="{Binding CostOfJob, StringFormat='{}{0:C}', ConverterCulture='en-GB'}" FontSize="20" FontWeight="Bold" Foreground="Black"/>
                            </StackPanel>



                            <Label Content="Delivery Address:" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="txtDeliveryAddress" Margin="0,0,0,10" Text="{Binding SelectedJob.DeliveryAddress}" Style="{StaticResource InputTextBox}" IsReadOnly="True" Height="51"/>

                            <Label Content="Description:" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="txtDescription" Margin="0,0,0,10" TextWrapping="Wrap" Style="{StaticResource InputTextBox}" Text="{Binding SelectedJob.Description}" IsReadOnly="True" Height="49"/>

                            <StackPanel Orientation="Horizontal">
                                <Label Content="Status:" Style="{StaticResource LabelStyle}"/>
                                <Label Content="{Binding SelectedJob.JobStatus}" Style="{StaticResource LabelBox}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>


                </Grid>
            </Border>
        </Grid>

    </Grid>
</UserControl>
