<UserControl x:Class="BayWyn_Couriers.Views.ManagerSubViews.ManagerContracts"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BayWyn_Couriers.Views.ManagerSubViews"
             xmlns:viewmodels="clr-namespace:BayWyn_Couriers.ViewModels" 
d:DataContext="{d:DesignInstance Type=viewmodels:ManagerVM}"
                      mc:Ignorable="d" 
         d:DesignHeight="600" d:DesignWidth="800">
    <Grid Background="AntiqueWhite" Margin="5">

        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Structure to hold the edit window and the buttons-->

        <!--Filter and date picker-->
        <ComboBox Grid.Row="0" Grid.Column="0" 
          ItemsSource="{Binding ContractsFilterList}"
          SelectedItem="{Binding SelectedContractStatus, UpdateSourceTrigger=PropertyChanged}"
          Margin="10" Width="120" HorizontalAlignment="Left" VerticalAlignment="Center">
        </ComboBox>

        <!--<DatePicker Grid.Row="0" Grid.Column="0" Margin="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>-->


        <Button Content="New Contract" Command="{Binding NewContractCommand}"
        Grid.Row="0" Grid.Column="0" Margin="10" 
        HorizontalAlignment="Right" Width="120"/>

        <!--Header for the edit column-->
        <TextBlock Grid.Row="0" Grid.Column="1" Text="Edit/New" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10"/>

        <!--Data grid for the Contracts to be displayed-->
        <DataGrid AutoGenerateColumns="False"
          ItemsSource="{Binding AllContracts}" 
          SelectedItem="{Binding Path=SelectedContract, Mode=TwoWay}"
          IsReadOnly="True"
          Grid.Row="1" Grid.Column="0" x:Name="ContractsList">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Contract ID" Binding="{Binding ContractId}" Width="Auto"/>
                <DataGridTextColumn Header="Company Name" Binding="{Binding CompanyName}" Width="*"/>
                <DataGridTextColumn Header="Status" Binding="{Binding ContractStatus}" Width="*"/>
            </DataGrid.Columns>

        </DataGrid>


        <Grid Grid.Row="1" Grid.Column="1" Width="350">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <!-- Edit section for the selected contract -->
            <StackPanel Grid.Row="0">

                <StackPanel Orientation="Horizontal">
                    <Label Content="Contract ID:"/>
                    <Label x:Name="txtContractID" Content="{Binding SelectedContract.ContractId, Mode=OneWay}" Width="50"/>
                </StackPanel>

                <!---->
                <StackPanel Orientation="Horizontal">
                    <Label Content="Company/Client:"/>
                    <ComboBox Width="200" x:Name="comboBoxClients" ItemsSource="{Binding ClientList}" SelectedItem="{Binding SelectedClient}"
                          DisplayMemberPath="Name" SelectedValuePath="ClientId" IsEnabled="{Binding EnableItemsForNewContract}"/>
                </StackPanel>

                <!--<TextBox x:Name="txtClientName" Margin="0,0,0,10" Text="{Binding SelectedContract.ClientName, Mode=TwoWay}"/>

            <Label Content="Courier Name:"/>
            <ComboBox ItemsSource="{Binding CouriersList}" 
                  SelectedItem="{Binding SelectedCourier, Mode=TwoWay}" 
                  DisplayMemberPath="UserName" SelectedValuePath="UserId" />
            -->

                <!--<TextBox x:Name="txtCourierName" Margin="0,0,0,10" Text="{Binding SelectedContract.CourierId, Mode=TwoWay}"/>-->

                <StackPanel Orientation="Horizontal">
                    <Label Content="Started Date:"/>
                    <TextBox IsEnabled="{Binding EnableItemsForNewContract}" Width="100" Text="{Binding SelectedContract.StartDate, StringFormat=d, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Label Content="End Date:     "/>
                    <TextBox IsEnabled="{Binding EnableItemsForNewContract}" Width="100" Text="{Binding SelectedContract.EndDate, StringFormat=d, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Label Content="Phone:"/>
                    <TextBox Margin="0,0,0,10" Width="200" Text="{Binding SelectedContract.PhoneNumber, Mode=TwoWay}" Height="30"/>
                </StackPanel>

                <Label Content="Email:"/>
                <TextBox Margin="0,0,0,10" Text="{Binding SelectedContract.Email, Mode=TwoWay}" Height="31"/>

                <Label Content="Address:"/>
                <TextBox Margin="0,0,0,10" Text="{Binding SelectedContract.Address, Mode=TwoWay}" Height="31"/>

                <Label Content="Notes:"/>
                <TextBox Margin="0,0,0,10" TextWrapping="Wrap" Text="{Binding SelectedContract.Notes, Mode=TwoWay}" Height="30"/>

                <StackPanel Orientation="Horizontal">
                    <Label Content="Contract Status:"/>
                    <ComboBox Width="150" 
                      ItemsSource="{Binding ContractsStatusList}"
                      SelectedItem="{Binding SelectedContract.ContractStatus, Mode=TwoWay}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Label Content="Monthly Cost"/>
                    <Label Content="{Binding SelectedContract.MonthlyCost}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Label Content="Cost Per Job"/>
                    <Label Content="{Binding SelectedContract.CostPerJob}"/>
                </StackPanel>



            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Delete" Command="{Binding DeleteContractCommand}" Width="50" Margin="5" />
                <Button Content="Update" Command="{Binding UpdateContractCommand}" Width="50" Margin="5"/>
                <Button Content="Renew" Command="{Binding RenewContractCommand}"  Width="50" Margin="5"/>
                <Button Content="Add" Command="{Binding AddContractCommand}" IsEnabled="{Binding EnableItemsForNewContract}" Width="50" Margin="5" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
